{
    "name": "mmrtonmoybd/omnipay-sslcommerz",
    "type": "library",
    "description": "SSLCommerz gateway for the Omnipay PHP payment processing library",
    "keywords": [
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "sslcommerz",
        "bangladesh",
        "bkash",
        "nagad"
    ],
    "homepage": "https://github.com/mmrtonmoybd/omnipay-sslcommerz",
    "license": "MIT",
    "authors": [
        {
            "name": "Moshiur Rahman",
            "email": "rmedha037@gmail.com",
            "homepage": "https://github.com/mmrtonmoybd"
        },
        {
            "name": "Omnipay SSLCommerz Contributors",
            "homepage": "https://github.com/mmrtonmoybd/omnipay-sslcommerz/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\SslCommerz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\SslCommerz\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.2|^8.0",
        "omnipay/common": "^3.1",
        "symfony/http-client": "^8.1"
    },
    "require-dev": {
        "http-interop/http-factory-guzzle": "^1.1",
        "league/omnipay": "^3.2",
        "omnipay/tests": "^4.1",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs -p --standard=PSR2 src/",
        "fix-style": "phpcbf -p --standard=PSR2 src/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
